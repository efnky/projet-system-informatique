%{
/*
 * interp.l  –  Lexer for the coded assembly interpreter
 *
 * The coded.asm file contains only:
 *   - non-negative integers (opcodes and operands)
 *   - whitespace / newlines as separators
 *
 * We return:
 *   INTEGER  for every number
 *   NEWLINE  to let the parser detect end-of-instruction
 *            (the number of operands depends on the opcode,
 *             so the newline is the only reliable line delimiter)
 */
#include "interp.tab.h"   /* generated by bison -d interp.y */
#include <stdlib.h>
%}

%%

[0-9]+       { yylval.nb = atoi(yytext); return INTEGER; }
\n           { return NEWLINE; }
[ \t\r]+     { /* skip spaces and tabs */ }
.            { /* ignore any unexpected character */ }

%%

int yywrap(void) { return 1; }
